generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         Int      @id @default(autoincrement())
  employeeId String   @unique
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  department String?
  position   String?
  hireDate   DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // The employee's manager (also an employee). Deleting a manager unlinks their team.
  managerId Int?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("ManagerReports")

  leaveRequests  LeaveRequest[] @relation("EmployeeLeave")
  leaveDecisions LeaveRequest[] @relation("LeaveDecider")

  attendance         Attendance[]           @relation("EmployeeAttendance")
  // Corrections asked for this employee's days, and the ones they asked for as a manager
  corrections        AttendanceCorrection[] @relation("CorrectionFor")
  correctionRequests AttendanceCorrection[] @relation("CorrectionRequester")

  // The login account of this employee, if they have one (a MANAGER or EMPLOYEE account)
  account Admin? @relation("AdminEmployee")

  // The one phone this employee checks in from, once registered
  device RegisteredDevice? @relation("EmployeeDevice")

  @@index([managerId])
}

model LeaveRequest {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Cascade)
  type             String // Annual, Sick, Casual
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  days             Int // working days
  reason           String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedAt        DateTime?
  // The manager (an employee) who approved or rejected it
  decidedById      Int?
  decidedBy        Employee? @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  // Or the HR admin account that decided it (HR can decide any request, e.g. for people with no manager)
  decidedByAdminId Int?
  decidedByAdmin   Admin?    @relation("LeaveDecidedByAdmin", fields: [decidedByAdminId], references: [id], onDelete: SetNull)
  decisionNote     String?
  createdAt        DateTime  @default(now()) // when it was requested
  updatedAt        DateTime  @updatedAt

  @@index([employeeId, status])
}

// One row per person per work day, created when they check in.
model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation("EmployeeAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date // the work day
  checkIn    DateTime // exact moment, stored in UTC
  checkOut   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// A change to a day's times: a manager's request that only an HR admin can approve, or a change
// an HR admin made directly (saved already approved, with no requester), so every change is traced.
// It is history, so it stays when the employee is deleted (the link becomes null).
model AttendanceCorrection {
  id               Int       @id @default(autoincrement())
  employeeId       Int?
  employee         Employee? @relation("CorrectionFor", fields: [employeeId], references: [id], onDelete: SetNull)
  // Who it was for (employee ID and name), kept with the row so the history still says so
  employeeCode     String?
  employeeName     String?
  date             DateTime  @db.Date
  // The times that are right. No check-in means HR removed the day's check-in.
  checkIn          DateTime?
  checkOut         DateTime?
  reason           String
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  // MANAGER: a manager's request. HR: an HR admin changed the day directly.
  source           String    @default("MANAGER")
  // The manager (an employee) who asked
  requestedById    Int?
  requestedBy      Employee? @relation("CorrectionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  // The HR admin account that approved or rejected it
  decidedById      Int?
  decidedBy        Admin?    @relation("CorrectionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decisionNote     String?
  // What the record said when HR approved it, so the change can be traced
  previousCheckIn  DateTime?
  previousCheckOut DateTime?
  createdAt        DateTime  @default(now()) // when it was requested
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([employeeId, date])
}

enum Role {
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

// Accounts that can log in: HR admins, managers and employees.
model Admin {
  id                  Int                    @id @default(autoincrement())
  email               String                 @unique
  name                String
  passwordHash        String
  // Goes up when the password changes; logins (tokens) made with an older value stop working
  tokenVersion        Int                    @default(0)
  role                Role                   @default(HR_ADMIN)
  // For MANAGER and EMPLOYEE accounts: the employee they are (a manager's team hangs off it)
  employeeId          Int?                   @unique
  employee            Employee?              @relation("AdminEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  // Attendance corrections this HR admin approved, rejected or made
  correctionDecisions AttendanceCorrection[] @relation("CorrectionDecider")
  // Leave requests this HR admin approved or rejected
  decidedLeave        LeaveRequest[]         @relation("LeaveDecidedByAdmin")
  approvedDevices     RegisteredDevice[]     @relation("DeviceApprover")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

// The one phone a person checks in from. The phone makes a random key, keeps it and sends it with
// every check-in and check-out; the server keeps only the key's SHA-256 hash. A new phone waits
// (PENDING) until an HR admin approves it. HR removes the row to reject a waiting phone or to
// reset a lost or replaced one, and the person registers the new one.
model RegisteredDevice {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @unique
  employee     Employee  @relation("EmployeeDevice", fields: [employeeId], references: [id], onDelete: Cascade)
  keyHash      String
  platform     String? // android or ios
  status       String    @default("PENDING") // PENDING, APPROVED
  // The HR admin account that approved it
  approvedById Int?
  approvedBy   Admin?    @relation("DeviceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now()) // when it was registered
  lastUsedAt   DateTime?
}
