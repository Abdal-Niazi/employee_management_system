generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         Int      @id @default(autoincrement())
  employeeId String   @unique
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  department String?
  position   String?
  hireDate   DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
