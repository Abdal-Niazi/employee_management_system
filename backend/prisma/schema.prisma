generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         Int      @id @default(autoincrement())
  employeeId String   @unique
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  department String?
  position   String?
  hireDate   DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // The employee's manager (also an employee). Deleting a manager unlinks their team.
  managerId Int?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("ManagerReports")

  leaveRequests  LeaveRequest[] @relation("EmployeeLeave")
  leaveDecisions LeaveRequest[] @relation("LeaveDecider")

  // The login account of this employee, if they have one (managers do)
  account Admin? @relation("AdminEmployee")

  @@index([managerId])
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Cascade)
  type         String // Annual, Sick, Casual
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  days         Int // working days
  reason       String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedAt    DateTime?
  // The manager (an employee) who approved or rejected it
  decidedById  Int?
  decidedBy    Employee? @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote String?
  createdAt    DateTime  @default(now()) // when it was requested
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, status])
}

enum Role {
  HR_ADMIN
  MANAGER
}

// Staff accounts that can log in. Existing accounts are HR admins.
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(HR_ADMIN)
  // For MANAGER accounts: the employee they are, whose team they manage
  employeeId   Int?      @unique
  employee     Employee? @relation("AdminEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
