# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ems_db

# Signs login tokens (required, at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts (default 12h: a whole shift, so nobody is signed out before checking out)
JWT_EXPIRES_IN=12h

PORT=5000
# Set to production on the server
NODE_ENV=development

# Browser origins allowed to call the API, comma separated (e.g. https://ems.example.com).
# Unset: any localhost port in development, none in production. Phone apps don't need this.
CORS_ORIGINS=
# Behind a reverse proxy (nginx, a load balancer, Render, Railway): how many proxies to trust, usually 1.
# Needed online: without it every user counts as one address for the rate limits, so a few wrong
# passwords from one person block everybody's sign-in (the server warns about it in production).
# Leave it empty only when the server is reached directly. See ../DEPLOY.md.
TRUST_PROXY=

# Rate limits. Failed sign-ins per 15 minutes: per IP and email, and per IP for all emails together.
LOGIN_RATE_LIMIT=10
LOGIN_IP_RATE_LIMIT=50
# API requests per minute: per IP (an office may share one), and per signed-in account.
IP_RATE_LIMIT=1000
API_RATE_LIMIT=300

# Leave each employee gets per calendar year, in working days
LEAVE_ANNUAL_DAYS=14
LEAVE_SICK_DAYS=8
LEAVE_CASUAL_DAYS=6
# Unused annual days that move into the next year, at most this many (0 = no carry-over), and the
# first year that gets carried days (so earlier years keep the balance they always showed)
LEAVE_CARRY_OVER_DAYS=5
LEAVE_CARRY_OVER_FIRST_YEAR=2027

# Attendance: one shift for everyone, Monday to Friday, in the company's timezone.
# A check-in more than LATE_GRACE_MINUTES after SHIFT_START counts as late.
SHIFT_START=09:00
SHIFT_END=17:00
LATE_GRACE_MINUTES=5
COMPANY_TIMEZONE=Asia/Karachi

# Only for npm test: a separate database whose name ends in _test. It is wiped on every run.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ems_test
